# Local development defaults. Committed deliberately — there is no secret here,
# and without it `npm run dev` renders the browser fixtures instead of the API,
# which looks like a working app and is not the product.
#
# Runtime requests use the same-origin server proxy. Configure its real HTTPS
# ERP_TENANT_API_URL and exact ERP_WEB_ORIGIN separately; absence fails closed.
NEXT_PUBLIC_DATA_SOURCE=api
