# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# …except the local development defaults, which hold no secret. Without them
# `npm run dev` renders the browser fixtures instead of the API — an app that
# looks like it works and is not the product.
!.env.development

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# macOS AppleDouble sidecars (exFAT volume)
._*
.DS_Store
/test-results
/playwright-report
/blob-report
